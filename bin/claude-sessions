#!/usr/bin/env bash
# Lists the live local Claude Code sessions and background agents, sorted so
# that the sessions waiting on the user come first, then the sessions that are
# not busy, then the busy ones. Within each group, the session idle longest
# comes first.
# NAME is the address that SendMessage and `claude agents` use for the session.
# WAITING says what an open prompt waits for, as `claude agents --json` reports
# it, such as "permission prompt" or "input needed".
# PR shows the status words of `git pr --json`. A PR under a queued PR in a
# stack shows that PR's queue status when live sessions work on the queued PR
# and on each PR in between.
# DEPENDS lists the PRs that an open PR waits on: the PR of the branch it
# targets when that is not the default branch, and each PR that a "Depends on"
# line in its body names. Each shows the name of the live session that works on
# it, when there is one.
# SIGNING says "blocked" when an idle session's last commit attempt failed to
# sign and its worktree still has uncommitted changes to tracked files.
# TAB is the Supacode tab ID.
#
# Switchboard's sbd manages some sessions. `sb ls --json` gives each live one's
# state and reason line, and that session takes its bucket and next step from
# them instead of from a transcript scan. The scan then skips the session, which
# it matches by Claude session ID or by pid. Without `sb`, or when sbd does not
# answer within 5 seconds, every session goes through the scan.
#
# Usage: claude-sessions [--json | --plan | --render <state file> [--act]]
# --json prints a JSON array with one object per session. The object holds the
# columns as fields, plus the transcript path and its tail: the first 1,000
# characters of the last user prompt and the last 1,000 characters of the last
# assistant text. running is {tool, input, minutes}: the tool's name, the first
# 500 characters of its Bash command or its description, and the minutes since
# the call. self is true for the session whose ID is $CLAUDE_CODE_SESSION_ID.
# An sbd session also has sb: {state, reason}. Its running is null, and its tail
# holds the last 1,000 characters of sbd's last reply and no prompt.
# supacodeWorktree is the Supacode worktree ID of the session's tab, or null
# when the session's git worktree is not the tab's worktree.
# repo is the owner/repo of the session's origin remote. A repo without an
# origin gives the path of its main worktree instead, which every worktree of
# the repo shares. repo is null outside a git repo.
# --plan saves the --json array to a new temp file. It prints the file's path
# as state, and the checks that the /sessions skill must answer for each session.
# It also tints the Supacode sidebar entry of each session whose PR merged gray,
# of each session whose PR is approved and ready for the Trunk queue green, and
# of each session whose PR is in a Trunk queue dark green. It clears those
# tints from the entry of each session with any other open PR.
# --render reads the skill's answers on stdin and prints the /sessions markdown for
# the state file. With --act, it also lists the sessions that Claude can
# continue. bin/lib/claude-sessions.jq holds the rules for both.

set -euo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
config_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
sign_fail='failed to sign|failed to write commit object|signing failed|agent refused operation|Couldn.t sign'
commit_ok='\[[A-Za-z0-9/._-]+ [0-9a-f]{7,}\] '
lib="$script_dir/lib"
merged_tint='#8E8E93'
ready_tint='#34C759'
queued_tint='#1E6B30'
inc='include "claude-sessions"; '

usage() {
  echo "Usage: claude-sessions [--json | --plan | --render <state file> [--act]]" >&2
  exit 2
}

mode=table
case "${1:-}" in
  --json) mode=json ;;
  --plan) mode=plan ;;
  --render)
    mode=render
    state=${2:-}
    act=false
    case "${3:-}" in
      --act) act=true ;;
      '') ;;
      *) usage ;;
    esac
    [[ -n "$state" && $# -le 3 ]] || usage
    if [[ ! -r "$state" ]]; then
      echo "claude-sessions: cannot read $state" >&2
      usage
    fi
    ;;
  '') ;;
  *) usage ;;
esac
[[ "$mode" == render || $# -le 1 ]] || usage

# A render reads its facts from the state file that --plan wrote. It never runs
# claude or gh.
if [[ "$mode" == render ]]; then
  answers=$(cat)
  [[ -n "${answers//[[:space:]]/}" ]] || answers='{}'
  if ! jq -n --argjson a "$answers" '$a' >/dev/null 2>&1; then
    echo "claude-sessions: the answers on stdin are not valid JSON" >&2
    exit 1
  fi
  exec jq -L "$lib" -r --argjson answers "$answers" --argjson act "$act" "$inc"'
    render($answers; $act) | if .errors then .errors | join("\n") + "\n" | halt_error(1) else .text end' "$state"
fi

# Prints the last signing failure or successful commit in a transcript.
# Only output from Bash calls that run a commit-creating git command counts,
# so a grep or file read that shows signing errors does not.
last_commit_outcome() {
  jq -r --arg re "$sign_fail|$commit_ok" '
    if .type == "assistant" then
      .message.content[]? | select(.type == "tool_use" and .name == "Bash" and (.input.command // "" | test("\\bgit\\b.*\\b(commit|rebase|cherry-pick|merge|revert|am|pull)\\b"; "s"))) | "U\t\(.id)"
    elif .type == "user" then
      .message.content[]? | select(.type == "tool_result") | "R\t\(.tool_use_id)\t\([.content | tostring | scan($re)] | last // "")"
    else empty end' "$1" 2>/dev/null |
    awk -F'\t' '$1 == "U" { c[$2] = 1 } $1 == "R" && ($2 in c) && $3 != "" { last = $3 } END { print last }'
}

# Prints {tail, running} for a transcript. tail holds the last user prompt and
# the last assistant text. The prompt keeps its first 1,000 characters. The
# assistant text keeps its last 1,000 characters, because a reply ends with its
# question or offer. The transcript records local command output as a user
# entry, but that entry is not a prompt.
# running is the last tool call that has no result and that no later prompt
# follows, or null. Its at is the call's transcript timestamp. A background Bash
# or Agent call gets its result at once, so it never counts.
transcript_facts() { # transcript
  tail -n 1000 "$1" 2>/dev/null | jq -Rn '
    def text: if type == "string" then . else [.[]? | select(.type == "text") | .text] | join("\n") end;
    def head_clip($n): if length > $n then .[:$n] + "…" else . end;
    def tail_clip: if length > 1000 then "…" + .[-1000:] else . end;
    def results: [.message.content | arrays | .[] | select(.type == "tool_result") | .tool_use_id];
    def prompt_text: select(.type == "user" and (.isMeta | not) and (.isCompactSummary | not)) | .message.content | text | select(. != "" and (startswith("<local-command-") | not));
    [inputs | fromjson? | select(.isSidechain | not)] as $entries
    | {
        tail: {
          user: ([$entries[] | prompt_text] | last // "" | head_clip(1000)),
          assistant: ([$entries[] | select(.type == "assistant") | .message.content | text | select(. != "")] | last // "" | tail_clip)
        },
        running: (reduce $entries[] as $e ([];
            if $e.type == "assistant" then
              . + [$e.message.content | arrays | .[] | select(.type == "tool_use")
                | {id, tool: .name, input: (.input.command // .input.description), at: $e.timestamp}]
            elif $e.type == "user" then
              ($e | results) as $done
              | if $done != [] then map(select(.id as $id | $done | index($id) | not))
                elif [$e | prompt_text] != [] then []
                else . end
            else . end)
          | map({tool, input: (.input | head_clip(500)), at})
          | last)
      }'
}

# Prints the PRs that an open PR waits on as a JSON array of {via, pr, url, base,
# deploy}, or nothing when it waits on none.
# A stack edge comes from a base branch other than <default>. Its pr and url are
# null.
# A body edge comes from a "Depends on" line in the PR body. The line names each
# PR as #N, owner/repo#N, or a URL. When the line mentions a deploy, the PR must
# be deployed and not only merged.
dependencies() { # dependencies <git pr --json object> <default branch>
  jq -L "$lib" -c --arg default "$2" "$inc"'
    select(.state == "OPEN")
    | (.url | repo) as $repo
    | [(select($default != "" and .base != $default) | {via: "stack", pr: null, url: null, base, deploy: false}),
        (.body // "" | split("\n")[] | select(test("^[\\s>*_-]*depends on\\b"; "i"))
          | test("deploy"; "i") as $deploy
          | pr_refs("")
          | {via: "body", pr, url: "https://github.com/\(.repo // $repo)/pull/\(.pr)", base: null, deploy: $deploy})]
    | select(. != [])' <<<"$1" 2>/dev/null
}

# Prints {<key>: <PR>}, where <PR> holds the number, url, state, and mergedAt of
# the PR at <url>, or of the PR from <branch> in <repo>. A fork PR from a branch
# with the same name does not count. <PR> is null when GitHub has no such PR or
# does not answer.
lookup_pr() { # lookup_pr <key> view <url> | lookup_pr <key> list <repo> <branch>
  local found
  if [[ "$2" == view ]]; then
    found=$(env GH_PAGER= gh pr view "$3" --json number,url,state,mergedAt 2>/dev/null) || found=
  else
    found=$(env GH_PAGER= gh pr list --repo "$3" --head "$4" --state all --limit 100 \
      --json number,url,state,mergedAt,isCrossRepository \
      -q '[.[] | select(.isCrossRepository | not)] | sort_by(.state != "OPEN") | .[0] // empty' 2>/dev/null) || found=
  fi
  jq -n -c --arg key "$1" --arg found "$found" '{($key): ($found | fromjson? // null)}'
}

# Prints one session's facts as a JSON object, or nothing when the session has
# exited or is a `claude -p` child.
session_facts() { # agent JSON from `claude agents --json`
  local agent=$1 sid pid cwd status updated_at='' entrypoint='' proc_env tab='' supacode_worktree='' supacode_path='' transcript mtime=''
  local facts='' top='' branch='' dirty='' git_dir='' origin='' default='' pr='' pr_file pr_pid signing='' depends=''

  {
    read -r sid
    read -r pid
    read -r cwd
    read -r status
  } < <(jq -r '.sessionId, (.pid // ""), (.cwd // ""), (.status // .state // "")' <<<"$agent")

  if [[ -n "$pid" ]]; then
    kill -0 "$pid" 2>/dev/null || return 0
    {
      read -r updated_at
      read -r entrypoint
    } < <(jq -r '(.statusUpdatedAt // .updatedAt // ""), (.entrypoint // "")' "$config_dir/sessions/$pid.json" 2>/dev/null) || true
    [[ "$entrypoint" == sdk* ]] && return 0
    proc_env=$(ps eww -o command= -p "$pid" 2>/dev/null | tr ' ' '\n') || return 0
    tab=$(sed -n 's/^SUPACODE_TAB_ID=//p' <<<"$proc_env")
    supacode_worktree=$(sed -n 's/^SUPACODE_WORKTREE_ID=//p' <<<"$proc_env")
    supacode_path=$(sed -n 's/^SUPACODE_WORKTREE_PATH=//p' <<<"$proc_env")
  fi

  transcript=$(find "$config_dir/projects" -maxdepth 2 -name "$sid.jsonl" -print -quit 2>/dev/null) || transcript=
  if [[ -n "$transcript" ]]; then
    facts=$(transcript_facts "$transcript") || facts=
    mtime=$(date -r "$transcript" +%s 2>/dev/null) || mtime=
  fi

  if [[ -n "$cwd" ]] && top=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null); then
    # `git pr` asks GitHub, so it runs while the worktree scan below runs.
    pr_file=$(mktemp "$tmp/pr.XXXXXX")
    (cd "$cwd" && exec "$script_dir/git-pr" --json) >"$pr_file" 2>/dev/null &
    pr_pid=$!
    branch=$(git -C "$cwd" branch --show-current 2>/dev/null) || branch=
    # Without --no-optional-locks, git status writes the index of a worktree that
    # a busy session may be using.
    dirty=$(git --no-optional-locks -C "$cwd" status --porcelain 2>/dev/null | wc -l | tr -d ' ') || dirty=
    git_dir=$(git -C "$cwd" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || git_dir=
    origin=$(git -C "$cwd" remote get-url origin 2>/dev/null) || origin=
    default=$(git -C "$cwd" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null) || default=
    default=${default#origin/}
    if [[ "$status" == idle && "$dirty" != 0 && -n "$transcript" ]] &&
      grep -qE "$sign_fail" <<<"$(last_commit_outcome "$transcript")" &&
      ! git -C "$cwd" diff --quiet HEAD 2>/dev/null; then
      signing=blocked
    fi
    wait "$pr_pid" || true
    pr=$(<"$pr_file")
    [[ -z "$pr" ]] || depends=$(dependencies "$pr" "$default") || depends=
  fi
  # A session can start in another worktree than its tab's, such as after a cd.
  # The Supacode worktree then does not hold the session's PR.
  if [[ -z "$top" || -z "$supacode_path" ]] ||
    [[ "$(cd "$supacode_path" 2>/dev/null && pwd -P)" != "$(cd "$top" && pwd -P)" ]]; then
    supacode_worktree=
  fi

  jq -L "$lib" -n \
    --argjson agent "$agent" \
    --arg status "$status" \
    --arg facts "$facts" \
    --arg updatedAt "$updated_at" \
    --arg mtime "$mtime" \
    --arg tab "$tab" \
    --arg supacodeWorktree "$supacode_worktree" \
    --arg transcript "$transcript" \
    --arg top "$top" \
    --arg branch "$branch" \
    --arg dirty "$dirty" \
    --arg gitDir "$git_dir" \
    --arg origin "$origin" \
    --arg pr "$pr" \
    --arg depends "$depends" \
    --arg signing "$signing" \
    --arg self "${CLAUDE_CODE_SESSION_ID:-}" "$inc"'
    def blank: if . == "" then null else . end;
    ($pr | fromjson? // null) as $pr
    | ($facts | fromjson? // {}) as $facts
    | (($updatedAt | tonumber?) // (($mtime | tonumber?) * 1000) // $agent.startedAt) as $since
    | {
        name: $agent.name,
        kind: $agent.kind,
        status: ($status | blank),
        idle: (if $since then $since | minutes_since else null end),
        waiting: (if $status == "waiting" then $agent.waitingFor // "input" else null end),
        branch: ($branch | blank),
        dirty: ($dirty | tonumber? // null),
        pr: ($pr | del(.body)),
        depends: ($depends | fromjson? // null),
        signing: ($signing | blank),
        tab: ($tab | blank),
        supacodeWorktree: ($supacodeWorktree | blank),
        worktree: ($top | blank),
        cwd: $agent.cwd,
        pid: $agent.pid,
        sessionId: $agent.sessionId,
        self: ($self != "" and $agent.sessionId == $self),
        repo: (($origin | remote_repo) // ($gitDir | sub("/\\.git/*$"; "") | blank)),
        gitDir: ($gitDir | blank),
        transcript: ($transcript | blank),
        tail: ($facts.tail // {user: "", assistant: ""}),
        running: ($facts.running | if . then {tool, input, minutes: ((.at | epoch_ms | minutes_since)? // null)} else null end)
      }'
}

# Prints the live sessions that sbd manages, as the JSON array that `sb ls
# --json` prints for them. It prints [] without `sb`, when sbd does not answer,
# or when the answer is not a JSON array. A session that is not live is left to
# the scan, which finds it only if `claude agents` still lists it.
sb_sessions() {
  local found
  command -v sb >/dev/null || { echo '[]'; return; }
  found=$(perl -e 'alarm shift; exec @ARGV or exit 127' 5 sb ls --json 2>/dev/null) || found=
  jq -n -c --arg found "$found" '
    ($found | fromjson? // null) | if type == "array" then [.[] | select(type == "object" and .live == true)] else [] end'
}

# Prints one sbd session's facts as a JSON object, in the shape of session_facts.
# sbd gives the state, the reason line, the PR, and the last reply. The git
# facts that grouping by repo needs come from the folder.
sb_facts() { # SessionSummary JSON from `sb ls --json`
  local summary=$1 cwd top='' git_dir='' origin=''
  cwd=$(jq -r '.cwd // ""' <<<"$summary")
  if [[ -n "$cwd" ]] && top=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null); then
    git_dir=$(git -C "$cwd" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || git_dir=
    origin=$(git -C "$cwd" remote get-url origin 2>/dev/null) || origin=
  fi
  jq -L "$lib" -n \
    --argjson s "$summary" \
    --arg top "$top" \
    --arg gitDir "$git_dir" \
    --arg origin "$origin" \
    --arg self "${CLAUDE_CODE_SESSION_ID:-}" \
    --arg sbSelf "${SB_SESSION_ID:-}" "$inc"'
    def blank: if . == "" then null else . end;
    def queue_word: {
      submitted: "Submitted to Trunk Queue", pending: "Waiting in Trunk Queue", testing: "Testing in Trunk Queue",
      passed: "Passed Trunk Queue", failing: "Failing in Trunk Queue", queued: "In Trunk Queue",
      removed: "Removed from Trunk Queue", unknown: "unknown"}[.];
    # The queue word follows the review word in the status, as git-pr prints it.
    def pr_facts:
      (if .queue then .queue | queue_word else null end) as $queue
      | {number, url, state, mergeable,
         status: ([.status, ($queue | select(. != null and . != "unknown"))] | join(", ")),
         queue: $queue, approvers: [], sb: true};
    {
      name: $s.name,
      kind: "interactive",
      status: (if $s.state == "working" then "busy" else "idle" end),
      idle: ($s.lastActivity // $s.since | minutes_since),
      waiting: null,
      branch: $s.branch,
      dirty: null,
      pr: ($s.pr | if . then pr_facts else null end),
      depends: null,
      signing: null,
      tab: null,
      supacodeWorktree: null,
      worktree: ($top | blank),
      cwd: $s.cwd,
      pid: $s.claudePid,
      sessionId: $s.claudeSessionId,
      self: (($self != "" and $s.claudeSessionId == $self) or ($sbSelf != "" and $s.id == $sbSelf)),
      repo: (($origin | remote_repo) // ($gitDir | sub("/\\.git/*$"; "") | blank)),
      gitDir: ($gitDir | blank),
      transcript: null,
      tail: {user: "", assistant: ($s.lastReply // "" | if length > 1000 then "…" + .[-1000:] else . end)},
      running: null,
      sb: {state: $s.state, reason: $s.reason}
    }'
}

agents=$(claude agents --json)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

sb_list=$(sb_sessions)

# `git pr` asks GitHub, so the sessions run in parallel.
i=0
while IFS= read -r summary; do
  i=$((i + 1))
  sb_facts "$summary" >"$tmp/$i.json" &
done < <(jq -c '.[]' <<<"$sb_list")
while IFS= read -r agent; do
  i=$((i + 1))
  session_facts "$agent" >"$tmp/$i.json" &
done < <(jq -c --argjson sb "$sb_list" '
  ($sb | map(.claudeSessionId)) as $ids
  | ($sb | map(.claudePid | values)) as $pids
  | .[] | select((.sessionId | IN($ids[])) or ((.pid // -1) | IN($pids[])) | not)' <<<"$agents")
wait

shopt -s nullglob
files=("$tmp"/*.json)
# A dependency edge takes its PR from the live session that works on that PR,
# or that has the stack edge's base branch checked out in the same repo. That
# session's `git pr` already asked GitHub.
sessions=$(cat "${files[@]}" /dev/null | jq -s '
  . as $all
  | map(
      . as $s
      | .depends[]? |= (
          . as $e
          | ([$all[] | select(.name != $s.name and
              if $e.base then .gitDir == $s.gitDir and .branch == $e.base
              else (.pr.url // "" | ascii_downcase) == ($e.url | ascii_downcase) end)] | first) as $under
          | if $under then
              . + {pr: $under.pr.number, url: $under.pr.url, state: $under.pr.state, mergedAt: $under.pr.mergedAt,
                session: $under.name}
            else . end))')

# GitHub answers for the PRs that no live session works on. The lookups run in
# parallel, one per PR.
n=0
while IFS=$'\t' read -r key how target branch; do
  n=$((n + 1))
  lookup_pr "$key" "$how" "$target" "$branch" >"$tmp/lookup.$n" &
done < <(jq -L "$lib" -r "$inc"'
  [.[] | (.pr.url | repo?) as $repo | .depends[]? | select(.session == null)
    | [edge_key($repo)] + if .url then ["view", .url] else ["list", $repo, .base] end | @tsv]
  | unique[]' <<<"$sessions")
wait
found=$(cat "$tmp"/lookup.* /dev/null | jq -s -c 'add // {}')

# Two edges to the same PR become one.
sessions=$(jq -L "$lib" --argjson found "$found" "$inc"'
  map(
    ((.pr.url | repo?) // null) as $repo
    | .depends[]? |= (
        (if .session then . else
          $found[edge_key($repo)] as $pr
          | . + {pr: ($pr.number // .pr), url: ($pr.url // .url), state: $pr.state, mergedAt: $pr.mergedAt, session: null}
        end)
        | .merged = ((.mergedAt | epoch_ms | minutes_since)? // null)
        | del(.mergedAt))
    | .depends |= (if . then
        reduce .[] as $e ([];
          if $e.url and any(.[]; .url == $e.url)
          then map(if .url == $e.url then .deploy = (.deploy or $e.deploy) else . end)
          else . + [$e] end)
      else . end)
    | del(.gitDir))
  | sort_by((if .waiting then 0 elif .status == "busy" then 2 else 1 end), -(.idle // 0))' <<<"$sessions")

# Trunk names a submitted stack only on its top PR until the stack enters the
# queue. A PR under a queued PR therefore takes that PR's queue status, unless
# its own status is a queued one. The walk down the stack follows only the stack
# edges whose PR a live session works on. Every session on a PR that the walk
# reaches takes the status, although a stack edge names only one of them.
sessions=$(jq -L "$lib" "$inc"'
  INDEX(.name) as $by
  | def under($seen):
      $by[.].depends[]? | select(.via == "stack") | .session | values
      | select(IN($seen[]) | not)
      | ., under($seen + [.]);
  ([.[] | select(.pr.queue | queued) | .pr.queue as $q | .name | under([.])
      | $by[.].pr.url | values | {key: ., value: $q}]
    | from_entries) as $stacked
  | map($stacked[.pr.url // ""] as $q
    | if $q and .pr.state == "OPEN" and (.pr.queue | queued | not) then
        .pr.status |= "\(split(", ")[0]), \($q)"
        | .pr.queue = $q
      else . end)' <<<"$sessions")

case "$mode" in
  json)
    echo "$sessions"
    exit 0
    ;;
  plan)
    # A tint that fails to apply does not fail the plan. Any other open PR's
    # entry loses only a tint that this script set. A tint that the user chose
    # stays.
    if command -v supacode >/dev/null; then
      own_tints=$(printf 'color=%s\n' "$merged_tint" "$ready_tint" "$queued_tint")
      while IFS=$'\t' read -r how id; do
        case "$how" in
          merged) tint=$merged_tint ;;
          ready) tint=$ready_tint ;;
          queued) tint=$queued_tint ;;
          *) tint= ;;
        esac
        if [[ -n "$tint" ]]; then
          supacode worktree appearance -w "$id" --color "$tint" --timeout 5 >/dev/null 2>&1 &
        else
          {
            supacode worktree appearance -w "$id" --timeout 5 2>/dev/null | grep -qxF "$own_tints" &&
              supacode worktree appearance -w "$id" --color none --timeout 5 >/dev/null 2>&1
          } &
        fi
      done < <(jq -L "$lib" -r "$inc"'tints' <<<"$sessions")
      wait
    fi
    state=$(mktemp "${TMPDIR:-/tmp}/claude-sessions.XXXXXX")
    echo "$sessions" >"$state"
    jq -L "$lib" --arg state "$state" "$inc"'{state: $state} + plan' <<<"$sessions"
    exit 0
    ;;
esac

{
  printf 'NAME\tKIND\tSTATUS\tIDLE\tWAITING\tBRANCH\tDIRTY\tPR\tDEPENDS\tSIGNING\tTAB\tWORKTREE\n'
  jq -L "$lib" -r --arg home "$HOME" "$inc"'
    def dash: if . == null or . == "" then "-" else tostring end;
    .[] | [
      .name, .kind, .status, (.idle | age), .waiting, .branch,
      (if .dirty == 0 then null else .dirty end),
      (if .pr then "#\(.pr.number) \(.pr.status)" else null end),
      (((.pr.url | repo?) // null) as $own | .depends // [] | map(
        (if .pr then (.url | repo | if . == $own then "" else . end) + "#\(.pr)" else .base end)
        + (if .session then " (\(.session))" else "" end)) | join(", ")),
      .signing, .tab,
      (.worktree // .cwd | if . and startswith($home + "/") then "~" + .[($home | length):] else . end)
    ] | map(dash) | @tsv' <<<"$sessions"
} | column -t -s $'\t'
