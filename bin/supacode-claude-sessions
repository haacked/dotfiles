#!/usr/bin/env bash
# Lists the interactive Claude Code sessions running in Supacode terminals.
# NAME is the address that SendMessage and `claude agents` use for the session.
# SIGNING says "blocked" when an idle session's last commit attempt failed to
# sign and its worktree still has uncommitted changes to tracked files.

set -euo pipefail

config_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
sign_fail='failed to sign|failed to write commit object|signing failed|agent refused operation|Couldn.t sign'
commit_ok='\[[A-Za-z0-9/._-]+ [0-9a-f]{7,}\] '
now=$(date +%s)

# Prints the last signing failure or successful commit in a transcript.
# Only output from Bash calls that run a commit-creating git command counts,
# so a grep or file read that shows signing errors does not.
last_commit_outcome() {
  jq -r --arg re "$sign_fail|$commit_ok" '
    if .type == "assistant" then
      .message.content[]? | select(.type == "tool_use" and .name == "Bash" and (.input.command // "" | test("\\bgit\\b.*\\b(commit|rebase|cherry-pick|merge|revert|am|pull)\\b"; "s"))) | "U\t\(.id)"
    elif .type == "user" then
      .message.content[]? | select(.type == "tool_result") | "R\t\(.tool_use_id)\t\([.content | tostring | scan($re)] | last // "")"
    else empty end' "$1" 2>/dev/null |
    awk -F'\t' '$1 == "U" { c[$2] = 1 } $1 == "R" && ($2 in c) && $3 != "" { last = $3 } END { print last }'
}

{
  printf 'NAME\tSTATUS\tIDLE\tSIGNING\tTAB\tWORKTREE\tPID\n'
  for session in "$config_dir"/sessions/*.json; do
    pid=$(basename "$session" .json)
    kill -0 "$pid" 2>/dev/null || continue

    # A session can exit between the checks below, so each lookup skips it on failure.
    # `claude -p` children inherit SUPACODE_* from their parent session but have no TTY.
    tty=$(ps -o tty= -p "$pid" 2>/dev/null | tr -d ' ') || continue
    [[ -z "$tty" || "$tty" == "??" ]] && continue

    env_vars=$(ps eww -o command= -p "$pid" 2>/dev/null | tr ' ' '\n') || continue
    worktree=$(sed -n 's/^SUPACODE_WORKTREE_PATH=//p' <<<"$env_vars")
    [[ -z "$worktree" ]] && continue
    tab=$(sed -n 's/^SUPACODE_TAB_ID=//p' <<<"$env_vars")

    # One field per line, because `read` merges adjacent tabs when a field is empty.
    fields=$(jq -r '.sessionId, (.name // ""), (.status // ""), (.updatedAt // 0)' "$session" 2>/dev/null) || continue
    {
      read -r sid
      read -r name
      read -r status
      read -r updated
    } <<<"$fields"
    idle=$(((now - updated / 1000) / 60))m

    signing=""
    if [[ "$status" == "idle" ]] && ! git -C "$worktree" diff --quiet HEAD 2>/dev/null; then
      transcript=$(find "$config_dir/projects" -maxdepth 2 -name "$sid.jsonl" -print -quit)
      if [[ -n "$transcript" ]] && grep -qE "$sign_fail" <<<"$(last_commit_outcome "$transcript")"; then
        signing="blocked"
      fi
    fi

    worktree=${worktree%/}
    [[ $worktree == "$HOME"/* ]] && worktree="~${worktree#"$HOME"}"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "${name:--}" "${status:--}" "$idle" "${signing:--}" "${tab:--}" "$worktree" "$pid"
  done
} | column -t -s $'\t'
