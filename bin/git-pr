#!/usr/bin/env bash
# Prints the URL of the PR for the current branch, or for an explicit
# <number>/<url> argument (passed straight to `gh pr view` unchanged).
# On a terminal the URL is followed by the PR's status: Draft, Ready, Approved,
# Changes requested, Merged, or Closed. An open PR that a Trunk merge queue has
# taken also shows its queue status, such as "Approved, Submitted to Trunk Queue".
# When other open PRs target this PR's branch, or this PR targets another open
# PR's branch, the stack follows on separate lines, top-down: the PRs stacked on
# this one, this PR marked with ">", the PRs it sits on, and the bottom base
# branch.
# Piped or captured output is the bare URL, which bin/lib/github.sh parses.
# Without a PR it prints "No PR" to stderr and exits 1. A branch that was never
# pushed, and the remote's default branch, get that answer without a gh call.
# --include-default-prs looks the default branch up anyway.
# Usage: git pr [--include-default-prs] [<number>|<url>]
#
# `gh pr view` with no argument resolves the head ref from the local
# branch name, not branch.<name>.merge, so it misses a fork PR checked out
# under a different local name (e.g. via `gh pr checkout`).
# This resolves the real branch name instead, then looks it up with
# `gh pr list --head`, which matches bare names across every fork, so a
# same-named branch in an unrelated fork (e.g. "main", "patch-1") can
# outrank the right one.
# The push remote's owner narrows that match back down to the right fork.
#
# An agent harness (PostHog Desktop, cloud runners) checks the PR head out
# detached, so there is no branch name to resolve. That case asks the
# commit-to-PR endpoint for HEAD's SHA instead. Code search is index-lagged and
# would miss a PR pushed moments ago.

set -e

# The `gh pr list` lookup below sorts on state.
# Both field sets include state for that lookup.
if [ -t 1 ]; then
    # GitHub leaves reviewDecision empty when the base branch requires no reviews.
    # latestReviews still records approvals and change requests in that case.
    # Trunk edits one status comment in place. The first line of that comment
    # names the queue state. Trunk posts submission errors as separate comments.
    # The status comment is therefore the last one whose first line has a known
    # phrase. The un-submitted control comment and the test analytics comment
    # match no phrase.
    format='def status:
        (if .state == "MERGED" then "Merged"
        elif .state == "CLOSED" then "Closed"
        elif .isDraft then "Draft"
        elif .reviewDecision == "APPROVED" then "Approved"
        elif .reviewDecision == "CHANGES_REQUESTED" then "Changes requested"
        elif (.reviewDecision // "") != "" then "Ready"
        elif any(.latestReviews[]; .state == "CHANGES_REQUESTED") then "Changes requested"
        elif any(.latestReviews[]; .state == "APPROVED") then "Approved"
        else "Ready" end)
        + ([select(.state == "OPEN") | .comments[]? | select(.author.login == "trunk-io")
            | .body | split("\n")[0] | ascii_downcase
            | if contains("removed from the merge queue") then "Removed from Trunk Queue"
              elif contains("running tests") then "Testing in Trunk Queue"
              elif contains("waiting to start tests") then "Waiting in Trunk Queue"
              elif contains("will be merged soon") then "Passed Trunk Queue"
              elif contains("submitted to merge") then "Submitted to Trunk Queue"
              else empty end]
           | map(", " + .) | last // "");
        "\(.url) \(.state) \(.isCrossRepository) \(.number) \(.headRefName) \(.baseRefName) \(status)"'
    # Branch names hold no spaces, so only the status in a format line can
    # contain one.
    # The retry below drops the trailing comments field, so it stays last.
    fields=url,number,state,isDraft,reviewDecision,latestReviews,headRefName,baseRefName,isCrossRepository,comments
else
    fields=url,state
    format=.url
fi

no_pr() { echo "No PR" >&2; exit 1; }

# Prints a format line for each open PR in $repo whose head or base branch is
# <branch>.
stack_lookup() { # stack_lookup --head|--base <branch>
    env GH_PAGER= gh pr list --repo "$repo" "$1" "$2" --state open --limit 100 \
        --json "$fields" -q ".[] | $format" 2>/dev/null
}

# Prints the open PRs stacked on <head> top-down. Each PR prints below the PRs
# stacked on it. A PR with siblings prints above the next sibling's PRs rather
# than above its base, so every sibling but the last names its base.
above() { # above <head> <number>
    local children i last cross n head status
    local -a kids
    # Every PR into the default branch would count as stacked on it.
    [ "$1" != "$default_branch" ] || return 0
    children=$(stack_lookup --base "$1") || return
    [ -n "$children" ] || return 0
    mapfile -t kids <<< "$children"
    last=$((${#kids[@]} - 1))
    for i in "${!kids[@]}"; do
        read -r _ _ cross n head _ status <<< "${kids[i]}"
        [ -z "${seen[$n]}" ] || continue
        seen[$n]=1
        # A fork PR's head branch is not in this repo, so no PR here can target it.
        if [ "$cross" = false ]; then above "$head" "$n" || return; fi
        [ "$i" -eq "$last" ] || status+=" (on #$2)"
        echo "  #$n $status"
    done
}

# Prints the open PRs under <base> top-down, then the bottom base branch.
# A base branch belongs to this repo, so the walk skips a fork PR whose head
# branch has the same name.
below() { # below <base>
    local base=$1 parent n status
    while [ "$base" != "$default_branch" ]; do
        parent=$(stack_lookup --head "$base") || return
        parent=$(grep -m1 '^[^ ]* [^ ]* false ' <<< "$parent") || break
        read -r _ _ _ n _ parent status <<< "$parent"
        [ -z "${seen[$n]}" ] || break
        seen[$n]=1
        echo "  #$n $status"
        base=$parent
    done
    echo "  $base"
}

# Prints a lookup's output. On a terminal the output is a format line, which
# prints as "<url> (<status>)". The stack follows when the PR is open and other
# open PRs share its stack.
show() { # show <lookup output>
    [ -t 1 ] || { echo "$1"; return; }
    local url state cross number head base status up='' down n
    read -r url state cross number head base status <<< "$1"
    echo "$url ($status)"
    [ "$state" = OPEN ] || return 0
    repo=${url#https://}
    repo=${repo%/pull/*}
    default_branch=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)
    default_branch=${default_branch#origin/}
    # Without the default branch, the walks would treat a PR from it as part of
    # the stack.
    [ -n "$default_branch" ] || return 0
    # Two open PRs can each target the other's head branch.
    local -A seen=(["$number"]=1)
    if [ "$cross" = false ]; then
        up=$(above "$head" "$number") || { echo "Stack lookup failed" >&2; return 0; }
    fi
    # above() marks PRs in its own subshell, so below() would list them again.
    [ -z "$up" ] || while read -r n _; do seen[${n#\#}]=1; done <<< "$up"
    down=$(below "$base") || { echo "Stack lookup failed" >&2; return 0; }
    # Without a PR under this one, $down holds only the base branch.
    [ -n "$up" ] || [ "$down" != "  $base" ] || return 0
    [ -z "$up" ] || echo "$up"
    echo "> #$number $status"
    echo "$down"
}

# gh queries the terminal's colors when its stdout is a terminal.
# Capturing its output avoids those queries.
# gh exits 1 for a missing PR and for an auth or network failure alike.
pr_view() {
    local pr
    err=$(mktemp)
    trap 'rm -f "$err"' EXIT
    if pr=$(env GH_PAGER= gh pr view "$@" --json "$fields" -q "$format" 2>"$err"); then
        show "$pr"
        return
    fi
    grep -qE 'Could not resolve to a PullRequest|no pull requests found' "$err" && no_pr
    cat "$err" >&2
    exit 1
}

include_default_prs=
[ "$1" = --include-default-prs ] && { include_default_prs=1; shift; }

if [ -n "$1" ]; then
    pr_view "$1"
    exit
fi

current_branch=$(git branch --show-current)

if [ -z "$current_branch" ]; then
    head_sha=$(git rev-parse HEAD 2>/dev/null || true)
    if [ -n "$head_sha" ]; then
        # The endpoint also lists PRs this commit merged *into*, so a detached
        # main would resolve to whatever landed last. Only an exact head.sha
        # match is this commit's own PR. The REST state is lowercase; the
        # `gh pr list` path below reads it uppercase.
        url=$(env GIT_PR_HEAD_SHA="$head_sha" GH_PAGER= gh api "repos/{owner}/{repo}/commits/${head_sha}/pulls" \
            --jq '[.[] | select(.head.sha == $ENV.GIT_PR_HEAD_SHA)] | sort_by(.state != "open") | .[0].html_url' 2>/dev/null || true)
        if [ -n "$url" ] && [ "$url" != "null" ]; then
            # The REST response has no reviewDecision.
            # A terminal therefore needs a second lookup for the status.
            if [ -t 1 ]; then pr_view "$url"; else echo "$url"; fi
            exit
        fi
    fi
    # The commit lookup is the only one that works on a detached HEAD.
    # `gh pr view` with no argument fails there before it asks GitHub.
    no_pr
fi

branch=$(git config "branch.$current_branch.merge" 2>/dev/null || true)
# Mirrors gh's own push-remote resolution order.
remote=$(git config "branch.$current_branch.pushRemote" 2>/dev/null || true)
[ -n "$remote" ] || remote=$(git config remote.pushDefault 2>/dev/null || true)
[ -n "$remote" ] || remote=$(git config "branch.$current_branch.remote" 2>/dev/null || true)
# "." means the branch tracks a local branch, not a remote one.
[ "$remote" = "." ] && { remote=""; branch=""; }
[ -n "$remote" ] || remote=origin

case "$branch" in
    refs/pull/*/head)
        # gh's own no-argument lookup already resolves this merge-ref form.
        pr_view
        exit
        ;;
esac

branch=${branch#refs/heads/}
if [ -z "$branch" ]; then
    # Without an upstream, only a remote-tracking ref shows that the branch
    # was pushed. A branch that was never pushed has no PR.
    git rev-parse --quiet --verify "refs/remotes/$remote/$current_branch" >/dev/null || no_pr
    branch=$current_branch
fi

# A PR rarely comes from the default branch of $remote.
# Skipping that lookup also avoids the slowest one, because many forks open PRs
# from a branch named main or master.
# The skip hides a PR from the default branch into another base branch. It also
# hides a PR from a fork's default branch into its upstream when $remote is the
# fork.
default=$(git symbolic-ref --quiet --short "refs/remotes/$remote/HEAD" 2>/dev/null || true)
[ -n "$include_default_prs" ] || [ "$default" != "$remote/$branch" ] || no_pr

# gh pr checkout writes the fork's URL, not a remote name, into
# branch.<name>.remote when the fork has no configured remote.
remote_url=$(git remote get-url "$remote" 2>/dev/null || echo "$remote")
remote_url=${remote_url%.git}
remote_url=${remote_url%/}
owner=${remote_url%/*}
owner=${owner##*[:/]}
owner=${owner,,}

# Prefers an OPEN PR over a merged one when both exist for the branch.
list_prs() { # list_prs <fields>
    env GIT_PR_OWNER="$owner" GH_PAGER= gh pr list --head "$branch" --state all --limit 100 \
        --json "$1,headRepositoryOwner" \
        -q '[.[] | select(((.headRepositoryOwner.login // "") | ascii_downcase) == $ENV.GIT_PR_OWNER)] | sort_by(.state != "OPEN") | .[0] // empty | '"$format"
}

if [ -t 1 ]; then
    # A lookup on a branch name that many forks share fetches the comments of
    # all their PRs. GitHub sometimes fails that lookup with a 502.
    # The status line from the retry has no queue status.
    # A gh failure for any other reason also costs this second attempt.
    pr=$(list_prs "$fields" 2>/dev/null) || pr=$(list_prs "${fields%,comments}")
else
    pr=$(list_prs "$fields")
fi

[ -n "$pr" ] || no_pr
show "$pr"
