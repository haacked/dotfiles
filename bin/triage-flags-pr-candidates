#!/usr/bin/env bash
# triage-flags-pr-candidates - Emit the open PostHog/posthog PRs from the last N
# days that carry no Feature Flags label, for the triage-issues skill to
# classify.
#
# One search finds the unlabeled PRs. The helper drops bots and external drafts,
# then fetches each remaining PR's changed files in parallel. External PRs
# (authors outside the org) keep their files and review state. Internal PRs (org
# members) are kept only when they touch a flags-domain path, and only those
# paths are listed. The path net is broad on purpose. The triage-feature-flags
# subagent rejects the incidental matches. Output is one JSON object on stdout:
#   {"fetched": N, "capped": bool,
#    "external": [{"number", "title", "author", "labels", "reviewDecision", "files"}],
#    "internal": [{"number", "title", "author", "isDraft", "paths"}],
#    "unfetched": [N, …]}
# capped is true when the search returned GitHub's 1000-result maximum. The
# oldest part of the window then went unscanned. unfetched lists the PRs whose
# per-PR fetch failed. Such an external PR has null files and reviewDecision.
# Such an internal PR is left out of internal because its paths are unknown.
# Progress logs go to stderr so stdout stays pure JSON.
#
# Read-only: it reads PR metadata, changed filenames, and review state. It never
# reads PR bodies or applies labels, so it stays outside the untrusted-content
# boundary the triage-issues skill enforces with its tool allowlist.
#
# Usage: triage-flags-pr-candidates [--days N]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DAYS=7
REPO="PostHog/posthog"
LIMIT=1000
PARALLEL=15

while [[ $# -gt 0 ]]; do
  case "$1" in
    --days) DAYS="$2"; shift 2 ;;
    *) echo "Unknown argument: $1" >&2; exit 2 ;;
  esac
done

since=$(date -v-"${DAYS}"d +%Y-%m-%d 2>/dev/null || date -d "${DAYS} days ago" +%Y-%m-%d)

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir "$work/details"

# Each PR's result goes to its own file. Parallel writers to one stream can
# interleave long lines. A PR whose fetch fails gets no file.
fetch_external() {
  local repo="$1" dir="$2" number="$3"
  if gh pr view "$number" --repo "$repo" --json number,files,reviewDecision \
      --jq '{number, files: [.files[].path], reviewDecision}' > "$dir/$number.out" 2>/dev/null; then
    mv "$dir/$number.out" "$dir/$number.json"
  fi
}

# gh pr view returns at most 100 files. Internal PRs use the paginated REST
# endpoint to see every path.
fetch_internal() {
  local repo="$1" dir="$2" number="$3"
  if gh api "repos/$repo/pulls/$number/files" --paginate --jq '.[].filename' > "$dir/$number.out" 2>/dev/null; then
    jq -Rnc --argjson number "$number" '{number: $number, files: [inputs]}' < "$dir/$number.out" > "$dir/$number.json"
  fi
}
export -f fetch_external fetch_internal

echo "Searching $REPO for unlabeled PRs since ${since}…" >&2

# gh honors a negated qualifier only as its own argument after --. Inside the
# quoted query string, gh drops it without an error. The posthog[bot] app opens
# most of the week's PRs. Excluding it keeps the results under the cap. The
# default sort is by relevance. Sorting newest first makes a capped search drop
# the oldest PRs instead of arbitrary ones.
gh search prs --repo "$REPO" --state open --limit "$LIMIT" --sort created --order desc \
  --json number,title,author,authorAssociation,isDraft,labels \
  -- "created:>=$since" \
  -label:team/feature-flags -label:feature/feature-flags -label:feature/cohorts -label:feature/early-access-management \
  -author:app/posthog \
  | jq --argjson limit "$LIMIT" -f "$SCRIPT_DIR/lib/triage-pr-classify.jq" > "$work/rows"

jq -r '"Found \(.fetched) unlabeled PRs; fetching details for \(.prs | map(select(.internal | not)) | length) external and \(.prs | map(select(.internal)) | length) internal non-bot PRs…"' "$work/rows" >&2

jq -r '.prs[] | select(.internal | not) | .number' "$work/rows" \
  | xargs -r -P "$PARALLEL" -n 1 bash -c 'fetch_external "$@"' _ "$REPO" "$work/details"
jq -r '.prs[] | select(.internal) | .number' "$work/rows" \
  | xargs -r -P "$PARALLEL" -n 1 bash -c 'fetch_internal "$@"' _ "$REPO" "$work/details"

find "$work/details" -name '*.json' -exec cat {} + > "$work/details.jsonl"

jq -c --slurpfile details "$work/details.jsonl" -f "$SCRIPT_DIR/lib/triage-pr-candidates.jq" "$work/rows"
