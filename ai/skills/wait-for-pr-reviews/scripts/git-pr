#!/usr/bin/env bash
# Prints the URL of the PR for the current branch, or for an explicit
# <number>/<url> argument (passed straight to `gh pr view` unchanged).
# On a terminal the URL is followed by the PR's status: Draft, Ready, Approved,
# Merged, or Closed. Piped or captured output is the bare URL, which
# bin/lib/github.sh parses.
# Without a PR it prints "No PR" to stderr and exits 1.
# Usage: git pr [<number>|<url>]
#
# `gh pr view` with no argument resolves the head ref from the local
# branch name, not branch.<name>.merge, so it misses a fork PR checked out
# under a different local name (e.g. via `gh pr checkout`).
# This resolves the real branch name instead, then looks it up with
# `gh pr list --head`, which matches bare names across every fork, so a
# same-named branch in an unrelated fork (e.g. "main", "patch-1") can
# outrank the right one.
# The push remote's owner narrows that match back down to the right fork.
#
# An agent harness (PostHog Desktop, cloud runners) checks the PR head out
# detached, so there is no branch name to resolve. That case asks the
# commit-to-PR endpoint for HEAD's SHA instead. Code search is index-lagged and
# would miss a PR pushed moments ago.

set -e

# The `gh pr list` lookup below sorts on state.
# Both field sets include state for that lookup.
if [ -t 1 ]; then
    # GitHub leaves reviewDecision empty when the base branch requires no reviews.
    # latestReviews still records an approval in that case.
    fields=url,state,isDraft,reviewDecision,latestReviews
    format='"\(.url) (\(
        if .state == "MERGED" then "Merged"
        elif .state == "CLOSED" then "Closed"
        elif .isDraft then "Draft"
        elif .reviewDecision == "APPROVED" then "Approved"
        elif (.reviewDecision // "") == "" and any(.latestReviews[]; .state == "APPROVED")
            and all(.latestReviews[]; .state != "CHANGES_REQUESTED") then "Approved"
        else "Ready" end))"'
else
    fields=url,state
    format=.url
fi

no_pr() { echo "No PR" >&2; exit 1; }

# gh queries the terminal's colors when its stdout is a terminal.
# Capturing its output avoids those queries.
# gh exits 1 for a missing PR and for an auth or network failure alike.
# Only gh's not-found messages become "No PR". Other errors print as gh wrote them.
pr_view() {
    local pr err
    err=$(mktemp)
    if pr=$(env GH_PAGER= gh pr view "$@" --json "$fields" -q "$format" 2>"$err"); then
        rm -f "$err"
        echo "$pr"
        return
    fi
    if grep -qE 'Could not resolve to a PullRequest|no pull requests found|not on any branch' "$err"; then
        rm -f "$err"
        no_pr
    fi
    cat "$err" >&2
    rm -f "$err"
    exit 1
}

if [ -n "$1" ]; then
    pr_view "$1"
    exit
fi

current_branch=$(git branch --show-current)

if [ -z "$current_branch" ]; then
    head_sha=$(git rev-parse HEAD 2>/dev/null || true)
    if [ -n "$head_sha" ]; then
        # The endpoint also lists PRs this commit merged *into*, so a detached
        # main would resolve to whatever landed last. Only an exact head.sha
        # match is this commit's own PR. The REST state is lowercase; the
        # `gh pr list` path below reads it uppercase.
        url=$(env GIT_PR_HEAD_SHA="$head_sha" GH_PAGER= gh api "repos/{owner}/{repo}/commits/${head_sha}/pulls" \
            --jq '[.[] | select(.head.sha == $ENV.GIT_PR_HEAD_SHA)] | sort_by(.state != "open") | .[0].html_url' 2>/dev/null || true)
        if [ -n "$url" ] && [ "$url" != "null" ]; then
            # The REST response has no reviewDecision.
            # A terminal therefore needs a second lookup for the status.
            if [ -t 1 ]; then pr_view "$url"; else echo "$url"; fi
            exit
        fi
    fi
fi
branch=""
remote=""
if [ -n "$current_branch" ]; then
    branch=$(git config "branch.$current_branch.merge" 2>/dev/null || true)
    # Mirrors gh's own push-remote resolution order.
    remote=$(git config "branch.$current_branch.pushRemote" 2>/dev/null || true)
    [ -n "$remote" ] || remote=$(git config remote.pushDefault 2>/dev/null || true)
    [ -n "$remote" ] || remote=$(git config "branch.$current_branch.remote" 2>/dev/null || true)
    # "." means the branch tracks a local branch, not a remote one.
    [ "$remote" = "." ] && { remote=""; branch=""; }
    [ -n "$remote" ] || remote=origin
fi

case "$branch" in
    refs/pull/*/head)
        # gh's own no-argument lookup already resolves this merge-ref form.
        pr_view
        exit
        ;;
esac

branch=${branch#refs/heads/}
[ -n "$branch" ] || branch=$current_branch

if [ -z "$branch" ]; then
    pr_view
    exit
fi

# gh pr checkout writes the fork's URL, not a remote name, into
# branch.<name>.remote when the fork has no configured remote.
remote_url=$(git remote get-url "$remote" 2>/dev/null || echo "$remote")
remote_url=${remote_url%.git}
remote_url=${remote_url%/}
owner=${remote_url%/*}
owner=${owner##*[:/]}
owner=${owner,,}

# Prefers an OPEN PR over a merged one when both exist for the branch.
pr=$(env GIT_PR_OWNER="$owner" GH_PAGER= gh pr list --head "$branch" --state all --limit 100 \
    --json "$fields,headRepositoryOwner" \
    -q '[.[] | select(((.headRepositoryOwner.login // "") | ascii_downcase) == $ENV.GIT_PR_OWNER)] | sort_by(.state != "OPEN") | .[0] // empty | '"$format")

[ -n "$pr" ] || no_pr
echo "$pr"
